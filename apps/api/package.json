{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=@crm/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "provision-tenant": "tsx --conditions=@crm/source --env-file-if-exists=../../.env src/cli/provision-tenant.ts",
    "super-admin": "tsx --conditions=@crm/source --env-file-if-exists=../../.env src/cli/super-admin.ts"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/shared": "workspace:*",
    "@hono/node-server": "2.1.4",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
