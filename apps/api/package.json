{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=@crm/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/shared": "workspace:*",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
