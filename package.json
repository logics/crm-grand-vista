{
  "name": "crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "pnpm --filter @crm/ui storybook",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "municipalities:snapshot": "pnpm --filter @crm/db municipalities:snapshot",
    "tenant:provision": "pnpm --filter @crm/api provision-tenant",
    "user:create": "pnpm --filter @crm/api user:create",
    "user:reset-password": "pnpm --filter @crm/api user:reset-password",
    "super-admin": "pnpm --filter @crm/api super-admin",
    "sessions:prune": "pnpm --filter @crm/api sessions:prune"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "oxlint": "1.87.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
