{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "design-system/**",
    ".agents/**",
    ".claude/**",
    "**/storybook-static/**"
  ],
  "plugins": [
    "react",
    "import"
  ],
  "jsPlugins": [
    "./tools/oxlint/crm-plugin.js"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "**/design-system/**"
            ],
            "message": "Referência visual do Design System não é código de produção (ADR 0003): use os componentes de `@crm/ui`."
          }
        ],
        "paths": [
          {
            "name": "lucide-react",
            "message": "Glifo vem do `Icon` de packages/ui; glifo novo entra no registro de `src/components/icon.tsx`."
          }
        ]
      }
    ],
    "crm/no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Cor hex crua — use um token de cor do Design System (classe do tema ou var())."
      },
      {
        "selector": ":matches(Literal[value=/--gv-/], TemplateElement[value.raw=/--gv-/])",
        "message": "Paleta crua (--gv-*) — use o apelido semântico; cor nova ganha apelido em packages/ui/src/tokens/colors.css."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Valor em px cru — use um token de espaçamento do Design System (classe do tema ou var())."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono|Jost))/i]",
        "message": "Fonte fora do Design System. Disponíveis: Geist, Geist Mono, Jost."
      },
      {
        "selector": "JSXOpeningElement[name.name='AsyncCombobox'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<AsyncCombobox> size aceita só 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|warning|danger|info|brand|gold)$/]",
        "message": "<Badge> tone aceita só 'neutral' | 'success' | 'warning' | 'danger' | 'info' | 'brand' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size aceita só 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|soft|dark|ghost|danger)$/]",
        "message": "<Button> variant aceita só 'primary' | 'accent' | 'secondary' | 'soft' | 'dark' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size aceita só 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|hero|inverse|sunken)$/]",
        "message": "<Card> tone aceita só 'default' | 'hero' | 'inverse' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChecklistItem'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ok|pending|blocked|empty)$/]",
        "message": "<ChecklistItem> state aceita só 'ok' | 'pending' | 'blocked' | 'empty'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompatibilityGauge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CompatibilityGauge> size aceita só 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size aceita só 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline|soft|solid)$/]",
        "message": "<IconButton> variant aceita só 'ghost' | 'outline' | 'soft' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size aceita só 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|gold|success|danger)$/]",
        "message": "<ProgressBar> tone aceita só 'brand' | 'gold' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:success|danger|neutral)$/]",
        "message": "<StatCard> deltaTone aceita só 'success' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|hero|dark|gold)$/]",
        "message": "<StatCard> tone aceita só 'default' | 'hero' | 'dark' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|info)$/]",
        "message": "<Toast> tone aceita só 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Wordmark> tone aceita só 'dark' | 'light'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/ui/src/components/icon.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "test/lint-adherence.test.ts"
      ],
      "rules": {
        "crm/no-restricted-syntax": "off"
      }
    }
  ]
}
