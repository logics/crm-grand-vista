# Variáveis de ambiente do CRM. Copie para `.env` e preencha.
# Lidas e validadas por um único módulo: packages/shared/src/env.ts.
# Se qualquer uma faltar ou for inválida, o processo não sobe e a mensagem
# diz qual. Nenhum valor abaixo é real.

# --- Banco ---------------------------------------------------------------

# Conexão da aplicação, com o papel `crm_app` (sujeito ao RLS).
# No container local (docker-compose.yml), a senha de cada papel é o próprio nome.
# Nunca aponte para `crm_owner`, `postgres` ou qualquer papel com BYPASSRLS:
# o Postgres não aplica RLS ao dono da tabela, e o isolamento some em silêncio.
DATABASE_URL=postgres://crm_app:<senha>@localhost:5433/crm_dev

# Conexão de migration, com o papel `crm_owner` (dono do schema).
# Lida só pelo processo de migration (`pnpm db:migrate`), nunca pela API.
MIGRATION_DATABASE_URL=postgres://crm_owner:<senha>@localhost:5433/crm_dev

# --- Autenticação --------------------------------------------------------

# Segredo do Better Auth, com ao menos 32 caracteres.
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- URLs ----------------------------------------------------------------

# URL base pública da API.
API_URL=http://localhost:3000

# URL base pública do front.
WEB_URL=http://localhost:5173

# Porta em que a API escuta. Opcional; padrão 3000.
# PORT=3000

# --- Container local (só docker compose) --------------------------------

# Porta do Postgres do container no host. Padrão 5433, para não colidir com um
# Postgres instalado na máquina (5432). Se mudar, ajuste as URLs acima junto.
# POSTGRES_PORT=5433
